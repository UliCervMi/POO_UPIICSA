<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="150.0" prefWidth="386.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cervantes.uli.edadpersona.PrimaryController">
   <children>
      <HBox prefHeight="18.0" prefWidth="200.0">
         <children>
            <Label text="Fecha de nacimiento" textAlignment="CENTER" />
            <DatePicker fx:id="fechaNac" />
         </children>
      </HBox>
      <HBox prefHeight="26.0" prefWidth="196.0">
         <children>
            <Button mnemonicParsing="false" onAction="#accionCalc" text="Calcular" />
            <Button mnemonicParsing="false" onAction="#accionLimp" text="Limpiar" />
         </children>
      </HBox>
      <Label fx:id="edad" alignment="CENTER" prefHeight="18.0" prefWidth="265.0" text="..." textAlignment="CENTER" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
