<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="350.0" prefHeight="400.0" 
      xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="cervantes.uli.conteo.PrimaryController">
    
    <padding>
        <Insets top="20.0" right="30.0" bottom="20.0" left="30.0" />
    </padding>

    <Label text="Contar número de clics" style="-fx-font-size: 14px;" />
    
    <TextField fx:id="contador" alignment="CENTER" editable="false" prefWidth="250.0" />
    
    <Button fx:id="cuenta" text="¡Contar!" onAction="#cuenta" prefWidth="100.0" />

    <VBox prefHeight="20.0" />

    <Label text="Esperar 10 segundos" style="-fx-font-size: 14px;" />
    
    <ProgressBar fx:id="progressBar" prefWidth="280.0" progress="0.0" />
    
    <Button fx:id="esperar" text="¡Esperar!" onAction="#espera" prefWidth="100.0" />

</VBox>